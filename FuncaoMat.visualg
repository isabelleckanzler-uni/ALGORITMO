algoritmo "FuncaoMat"

var
   result: inteiro
   opcao: inteiro

inicio
  escreval("Escolher qual função vai fazer:")
  escreval ("1-Valor absoluto, 2-quadrado de um número,3-seno,4-cosseno,5-tangente, 6-exponencial,7-logaritmo")
  leia(opcao)
  escolha opcao
   caso 1
   escreval("Digite um número : ")
   leia(result)
   escreval("Valor absoluto  ", result , ": " + abs(result))
   caso 2
   escreval("Digite um número : ")
   leia(result)
   escreval("Quadrado de ", result , ": " + quad (result))
   caso 3
   escreval("Digite um número : ")
   leia(result)
   escreval(" Valor de seno", result , ": " , sen(result))
   caso 4
   escreval("Digite um número : ")
   leia(result)
   escreval("Valor de cosseno", result , ": ", cos(result))
   caso 5
   escreval("Digite um número : ")
   leia(result)
   escreval(" Valor de tangente", result , ": " , tan(result))
   caso 6
  escreval("Digite um número : ")
  leia(result)
  escreval("Valor de exponencial ", result , ": ", exp(result))
   caso 7
  escreval("Digite um número : ")
  leia(result)
  escreval("Valor de logaritmo ", result , ": ", log(result))
  fimescolha


fimalgoritmo

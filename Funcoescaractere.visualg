algoritmo "Funcaocaractere"

var
   text: caractere

inicio
   escreval("Digite seu nome: ")
   leia(text)
   
   escreval("Texto original: ", text)
   escreval("Cópia dos 3 primeiros caracteres: "+ copia(text, 1, 3))
   escreval("Quantidade de caracteres:" , compr(text))
   escreval("Texto maiúsculas:", maiusc(text))
   escreval("Texto minúsculas: " , minusc(text))
   
   se compr(text) > 3 entao
      text <- minusc(text)
   fimse
   
   escreval("Resultado final: ", text)

fimalgoritmo
